{
	"name": "river-conditions",
	"version": "1.0.0",
	"private": true,
	"description": "WordPress block and shortcode for live USGS river conditions.",
	"author": "Kai Shade",
	"license": "GPL-2.0-or-later",
	"repository": {
		"type": "git",
		"url": "https://github.com/Kaijann/river-conditions.git"
	},
	"engines": {
		"node": ">=22"
	},
	"files": [
		"river-conditions.php",
		"uninstall.php",
		"readme.txt",
		"LICENSE",
		"src",
		"build",
		"assets",
		"languages"
	],
	"scripts": {
		"build": "wp-scripts build --webpack-src-dir=blocks --webpack-copy-php",
		"start": "wp-scripts start --webpack-src-dir=blocks --webpack-copy-php",
		"lint:js": "wp-scripts lint-js blocks assets",
		"lint:css": "wp-scripts lint-style \"blocks/**/*.scss\"",
		"format": "wp-scripts format blocks assets",
		"plugin-zip": "wp-scripts plugin-zip",
		"env": "wp-env",
		"env:start": "wp-env start",
		"env:stop": "wp-env stop"
	},
	"devDependencies": {
		"@wordpress/env": "^11.17.0",
		"@wordpress/scripts": "^36.1.0"
	}
}
